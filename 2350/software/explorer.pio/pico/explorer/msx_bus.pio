; -----------------------------------------------------------------------
; Pin mapping (directly from multirom.h):
;   GPIO  0-15  = A0..A15   (address bus, always input)
;   GPIO 16-23  = D0..D7    (data bus, bidirectional)
;   GPIO 24     = /RD       (active-low read strobe)
;   GPIO 25     = /WR       (active-low write strobe)
;   GPIO 26     = /IORQ     (active-low I/O request)
;   GPIO 27     = /SLTSL    (active-low slot select)
;   GPIO 28     = /WAIT     (active-low, open-drain via PIO pindir)
;   GPIO 37     = BUSSDIR
;   GPIO 47     = PSRAM select
;
; -----------------------------------------------------------------------
; Architecture:
;
;   SM0 = msx_read_responder   (handles memory reads)
;   SM1 = msx_write_captor     (handles memory writes / bank switching)
;   SM2 = msx_io_read_responder (I/O reads; pio0 because it drives D0..D7)
;   msx_io_write_captor runs on pio2 (input only).
;
; Read flow:
;   1. Wait for /SLTSL=0 and /RD=0
;   2. Assert /WAIT=0 (freeze Z80)
;   3. Capture A0..A15 and push to RX FIFO
;   4. Wait for token from CPU in TX FIFO
;   5. Output data and pin directions
;   6. Release /WAIT as hi-Z, then wait for /RD high
;   7. Tri-state data bus and loop
;
; Write flow:
;   1. Wait for /SLTSL=0 and /WR=0
;   2. Snapshot GPIO 0..23 (A0..A15 + D0..D7)
;   3. Push sample to RX FIFO
;   4. Wait for /WR high and loop
;

.program msx_read_responder

.wrap_target
wait_sltsl:
    wait 0 gpio 27                ; Wait for /SLTSL=0
    jmp pin wait_sltsl            ; If /RD=1, re-check /SLTSL
    set pindirs, 1                ; Assert /WAIT=0 immediately
    in pins, 16                   ; Capture A0..A15 into ISR
    push block                    ; Send address to CPU via RX FIFO
    pull block                    ; Wait for CPU response in TX FIFO
    out pins, 8                   ; Drive D0..D7 with data byte
    out pindirs, 8                ; Set pindirs (0xFF=out, 0x00=in)
    set pindirs, 0         [1]    ; Release /WAIT as hi-Z
    wait 1 gpio 24                ; Wait for /RD=1
    set x, 0
    mov osr, x
    out pindirs, 8                ; Tri-state D0..D7
.wrap

.program msx_write_captor

; MSX_MEM_SETTLE: extra PIO cycles between observing /WR low and latching the
; address+data bus. At 210 MHz each cycle is ~4.8 ns. Raise this if a machine's
; slot buffers present data later than the Pico samples it.
.define MSX_MEM_SETTLE 2

.wrap_target
wait_sltsl:
    wait 0 gpio 27            ; Wait for /SLTSL=0
    jmp pin wait_sltsl        ; If /WR=1, re-check /SLTSL
    nop  [MSX_MEM_SETTLE]     ; Let address/data settle
    mov isr, pins             ; Snapshot GPIOs
    push block                ; Send (addr+data) to CPU
    wait 1 gpio 25            ; Wait for /WR=1
.wrap

; ===================================================================
; msx_io_write_captor
; ===================================================================
; Captures address + data during MSX I/O write cycles (/IORQ + /WR).
; Used for intercepting writes to mapper ports (FC-FF) and sub-slot
; register at FFFF.
;
; RX FIFO word format:
;   bits[15:0]  = A0..A15
;   bits[23:16] = D0..D7
;
; No side-set, no out pins needed.
; FIFO join RX for deep buffering (8 entries).

.program msx_io_write_captor

; jmp_pin must be configured to /WR (GPIO 25) from C code.
;   /WR=1 (inactive) → jump taken  → re-check /IORQ
;   /WR=0 (active)   → fall through → capture the write
;
; Data-bus timing: an I/O write never asserts /SLTSL, so on machines that gate
; the cartridge slot data buffer the real byte appears on D0..D7 noticeably
; later in the cycle than it does for a memory write. Latching a fixed few
; nanoseconds after /WR falls captured whatever the undriven bus still held -
; on a Yamaha this was the operand byte of the preceding "OUT (n),A" fetch, so
; the sampled data equalled the port number and every mirrored PSG register
; write was garbage.
;
; Instead of guessing a settling delay, re-sample continuously for as long as
; /WR is asserted and keep the last snapshot taken before it rises. That is
; what real I/O hardware does (it latches on the trailing edge of /WR), it is
; correct regardless of how late a particular machine drives the bus, and it
; adapts automatically to CPU speed (3.58 MHz, turbo or R800).

.wrap_target
wait_iorq:
    wait 0 gpio 26           ; Wait for /IORQ=0 (I/O request)
    jmp pin wait_iorq        ; If /WR=1 (no write), re-check /IORQ
resample:
    mov isr, pins            ; Snapshot A0..A15 + D0..D7
    jmp pin capture          ; /WR rose: ISR holds the last in-cycle sample
    jmp resample
capture:
    push block               ; Send (addr+data) to CPU via RX FIFO
.wrap

; ===================================================================
; msx_io_read_responder
; ===================================================================
; Responds to MSX I/O read cycles (/IORQ + /RD).
; Used for reading mapper port registers (FC-FF) and the C2 port (F0-F3).
; Runs on pio0 next to msx_read_responder: D0..D7 are muxed to pio0, and only
; that block can drive them. Memory and I/O cycles never overlap.
;
; in_base     = GPIO 0  (A0), 16 pins
; out_base    = GPIO 16 (D0), 8 pins
;
; /WAIT is not asserted, so the CPU answer can arrive after the I/O cycle has
; ended. Before driving, /IORQ is re-checked: if the cycle is already over the
; token is dropped, so a late answer can never drive the bus during the next
; (memory) cycle. Must stay at 13 instructions: pio0 holds 13 + 6 + 13 = 32.

.program msx_io_read_responder

; jmp_pin must be configured to /IORQ (GPIO 26) from C code.
;   /IORQ=1 (inactive) → jump taken  → not an I/O cycle / cycle ended
;   /IORQ=0 (active)   → fall through

.wrap_target
wait_rd:
    wait 0 gpio 24                ; Wait for /RD=0 (read cycle)
    jmp pin wait_rd               ; If /IORQ=1 (memory read), re-check
    nop                           ; timing spacer
    in pins, 16                   ; Capture A0..A15 into ISR
    push block                    ; Send address to CPU via RX FIFO
    pull block                    ; Wait for CPU response in TX FIFO (data token)
    jmp pin cycle_over            ; /IORQ=1: I/O cycle already ended, never drive
    out pins, 8                   ; Drive D0..D7 with data byte
    out pindirs, 8         [2]    ; Set pindirs (0xFF=output, 0x00=tristate) + data hold
    wait 1 gpio 24                ; Wait for /RD=1 (bus cycle ends)
cycle_over:
    set x, 0                      ; Prepare zero for tri-state
    mov osr, x                    ; Load zero into OSR (drops an unused token)
    out pindirs, 8                ; Tri-state D0..D7 (pindirs=0x00)
.wrap