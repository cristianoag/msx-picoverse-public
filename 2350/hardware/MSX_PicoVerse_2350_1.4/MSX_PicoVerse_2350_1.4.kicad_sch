			(justify left bottom)
		)
		(uuid "882332dd-b8d4-45c4-923d-fb85a336459d")
	)
	(text "(2) 전원 재구성 : MSX +5V 는 아이디얼 다이오드(Q1/Q2), USB VBUS 는 D2 + F1(PTC). +3V3 은 IC1 AP63200 벅."
		(exclude_from_sim no)
		(at 20.828 39.434 0)
		(effects
